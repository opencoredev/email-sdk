{
  "name": "email-sdk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "lint": "oxlint --disable-nested-config --deny-warnings --report-unused-disable-directives && bun scripts/check-lint-policy.ts",
    "check": "bun run lint && oxfmt --write",
    "changeset": "changeset",
    "version-packages": "changeset version && bun scripts/sync-sdk-version.ts",
    "verification:check": "bun scripts/check-adapter-verification.ts && bun test scripts/check-adapter-verification.test.ts apps/docs/lib/adapter-verification.test.ts",
    "release:ci": "bun run lint && bun run check-types && bun run test && bun run verification:check && bun run community:check && bun run docs:versions:check && bun run docs:check && bun run build && bun run docs:audit && bun run pack:check",
    "release": "changeset publish",
    "pack:check": "bun scripts/check-package-tarballs.ts",
    "convex:deploy-check": "bun scripts/check-convex-deploy.ts",
    "live:resend": "bun scripts/check-resend-account.ts",
    "live:sequenzy": "bun scripts/check-sequenzy-account.ts",
    "live:lettermint": "bun scripts/check-lettermint-account.ts",
    "live:lettr": "bun scripts/check-lettr-account.ts",
    "live:sendheron": "bun scripts/check-sendheron-account.ts",
    "live:helo": "bun scripts/check-helo-account.ts",
    "live:graph": "bun scripts/check-graph-account.ts",
    "live:plan": "bun scripts/changed-live-adapters.ts",
    "live:run": "bun scripts/run-live-adapters.ts",
    "community:check": "bun scripts/validate-community-registry.ts",
    "docs:versions:check": "bun scripts/validate-docs-versions.ts",
    "docs:check": "bun scripts/check-adapter-support-docs.ts && bun scripts/check-published-exports.ts && bun test scripts/check-cli-doc-consistency.test.ts scripts/check-published-exports.test.ts && cd apps/docs && bun run types:check && bun run adapter-faq:check && bun run compare:check && bun run registry:check && bun run validate",
    "homebrew:update": "bun scripts/update-homebrew-formula.ts",
    "docs:audit": "cd apps/docs && bun run audit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@email-sdk/config": "workspace:*",
    "@oxlint/plugins": "1.85.0",
    "oxfmt": "^0.79.0",
    "oxlint": "1.85.0",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@opencoredev/email-sdk": "workspace:*",
    "browserslist": "4.28.7",
    "compression": "1.8.2",
    "dompurify": "3.4.17",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.9",
    "fflate": "0.4.9",
    "path-to-regexp": "6.3.0",
    "postcss-selector-parser": ">=6.1.5",
    "read-yaml-file": "3.0.0",
    "seroval": "1.6.11",
    "source-map-js": "1.2.2",
    "ws": "^8.21.0"
  },
  "packageManager": "bun@1.3.14"
}
