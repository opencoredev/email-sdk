# Local task-only database. Never point tests at a shared database.
DATABASE_URL=postgres://email_sdk_test@127.0.0.1:5438/email_sdk_adoption
DATABASE_SCHEMA=durable_email
# Integration tests require a separate explicit opt-in URL; each run creates/drops one random schema.
# DURABLE_TEST_DATABASE_URL=postgres://email_sdk_test@127.0.0.1:5438/email_sdk_adoption
EMAIL_SDK_TELEMETRY=0
EMAIL_MODE=memory
EMAIL_ACCOUNT=local-fixture
# Both mode=resend and this exact opt-in are required to construct a live sender.
# EMAIL_LIVE_SEND=I_AUTHORIZE_REAL_EMAIL
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=whsec_...
# WEBHOOK_ACCOUNT=production-resend-account
WEBHOOK_PORT=8787
