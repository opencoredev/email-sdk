# Copy to .env. `npm run validate` works with these placeholders unchanged;
# `npm run send` refuses to run until all three are real values.

# Server-side Resend API key (https://resend.com/api-keys). Never ship it to a browser.
RESEND_API_KEY=re_replace_with_real_server_key

# Sender on a domain you verified at https://resend.com/domains. `Name <address>` is allowed;
# keep the quotes so the file also sources cleanly in a shell (set -a; . ./.env; set +a).
EMAIL_FROM="Starter <hello@example.com>"

# Recipient you control. With the shared onboarding@resend.dev sender, Resend only
# accepts your own account email address here.
EMAIL_TO=recipient@example.com

# Optional: disable the SDK's anonymous telemetry (on by default).
# EMAIL_SDK_TELEMETRY=0
