{
  "name": "@email-sdk/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "blume dev",
    "prebuild": "bun scripts/generate-lastmod.ts && bun run registry:check && bun run adapter-faq:check && bun run compare:check && bun scripts/fetch-notra-posts.ts && bun scripts/generate-feeds.ts && bun run og:generate",
    "build": "blume build && bun scripts/patch-vercel-config.ts",
    "preview": "bun scripts/preview-static.ts",
    "validate": "blume validate --strict",
    "audit": "blume audit",
    "check": "bun scripts/ensure-sdk-built.ts && blume check --strict",
    "types:check": "bun scripts/ensure-sdk-built.ts && tsc --noEmit",
    "posts:fetch": "bun scripts/fetch-notra-posts.ts",
    "og:generate": "bun scripts/og/generate-og-image.ts && bun scripts/og/generate-compare-og.ts",
    "field-support:generate": "bun scripts/generate-field-support.ts",
    "registry:generate": "bun scripts/generate-email-registry.ts",
    "registry:check": "bun scripts/generate-email-registry.ts --check",
    "adapter-faq:generate": "bun scripts/generate-adapter-faq.ts",
    "adapter-faq:check": "bun scripts/generate-adapter-faq.ts --check",
    "lastmod:generate": "bun run adapter-faq:generate && bun scripts/generate-lastmod.ts",
    "test": "bun test",
    "compare:generate": "bun scripts/generate-compare-pages.ts",
    "compare:check": "bun scripts/generate-compare-pages.ts --check",
    "check-types": "bun scripts/ensure-sdk-built.ts && tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@opencoredev/email-sdk": "workspace:*",
    "blume": "2.2.7",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "4.6.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "~1.4.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@usenotra/sdk": "^1.3.6",
    "marked": "^18.2.1",
    "sanitize-html": "^2.18.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19"
  }
}
